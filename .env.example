# This file documents environment variables; the service does not load .env.
CONFIG_FILE=config/config.example.yaml
APP_ENV=development
HTTP_ADDR=:8080
GRPC_ADDR=:9090
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=5s
DATABASE_DSN=
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
SPICEDB_ENABLED=false
SPICEDB_ENDPOINT=
SPICEDB_TOKEN=
SPICEDB_INSECURE=false
SPICEDB_CA_FILE=
SPICEDB_SERVER_NAME=
SPICEDB_TIMEOUT=5s
