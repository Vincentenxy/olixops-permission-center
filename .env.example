# OlixOps Permission Center 本地环境变量模板
#
# 使用方法：复制为 .env，再通过 GoLand 的 EnvFile 插件或操作系统注入变量。
# 服务本身不会主动解析 .env；仅创建文件但未注入时不会生效。
# .env 已被 Git 忽略。不要把数据库密码、JWT 密钥或 SpiceDB Token 提交到仓库。
# 只验证健康接口时，数据库和 JWT 可以留空；使用登录及管理功能时请填写标注的必填项。
# 注意：EnvFile 会注入空值，KEY= 也会覆盖 YAML 中的值。若某项改由 config/config.yaml
# 提供，请删除 .env 中对应的整行，不要只保留等号后的空值。
# 首次登录前还需执行数据库文档中的七表 DDL，并通过 cmd/bootstrap-admin 初始化超管。
# BOOTSTRAP_PASSWORD 等一次性变量应在执行命令时临时输入，不要长期保存在 .env。

# -----------------------------------------------------------------------------
# 配置来源与运行环境
# -----------------------------------------------------------------------------

# 可选：基础 YAML 配置路径。相对路径按 GoLand 运行配置的工作目录解析。
# 设置后文件必须存在且可读，否则服务启动失败；环境变量会覆盖 YAML 中的同名配置。
# 使用本模板时保留安全示例配置；也可以改为本地 config/config.yaml。
CONFIG_FILE=config/config.example.yaml

# 可选：development 输出便于阅读的日志；小写 production/release 输出 JSON 日志。
APP_ENV=development

# -----------------------------------------------------------------------------
# HTTP、gRPC 与进程生命周期
# -----------------------------------------------------------------------------

# 可选：监听地址，格式为 host:port；省略 host 表示监听所有网卡。
HTTP_ADDR=:8080
GRPC_ADDR=:9090

# 可选：Go duration 格式，例如 500ms、10s、2m；必须大于 0，不能只写裸数字。
# HTTP_WRITE_TIMEOUT 同时限制单个 HTTP 用例的执行时长。
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=5s

# 可选：仅部署在 Nginx/Higress 等代理后时填写实际代理对端 IP/CIDR。
# 多项使用英文逗号分隔，例如 192.0.2.10,198.51.100.0/24；不能填域名或 URL。
# 本地直连保持空值并忽略 X-Forwarded-*；不要使用 0.0.0.0/0 或 ::/0 放开所有来源。
HTTP_TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# PostgreSQL（登录及管理功能必填）
# -----------------------------------------------------------------------------

# 必填：权限中心自己的业务数据库 DSN，不是 SpiceDB datastore。
# 数据库名和用户均固定为 permission_center，且必须先按数据库文档创建七张表。
# 示例：host=<地址> port=5432 user=permission_center password=<密码> dbname=permission_center search_path=public sslmode=disable
# 密码含空格或特殊字符时按 PostgreSQL DSN 规则转义。非空连接失败会阻止服务启动。
# 生产环境应按数据库证书配置 sslmode；服务不会自动建表，不能直接照搬本地的 disable。
DATABASE_DSN=

# -----------------------------------------------------------------------------
# Redis（当前可选，留空即禁用）
# -----------------------------------------------------------------------------

# 可选：当前只支持一个 host:port，不是 redis:// URL；留空不会连接 Redis。
# 没有 REDIS_ENABLED 变量，REDIS_ADDR 非空即启用；启动 Ping 失败会阻止服务启动。
REDIS_ADDR=

# 可选：Redis 无密码时留空。
REDIS_PASSWORD=

# 可选：Redis 数据库编号，必须是大于或等于 0 的整数。
REDIS_DB=0

# -----------------------------------------------------------------------------
# 管理员登录 JWT（登录及管理功能必填）
# -----------------------------------------------------------------------------

# 必填：同一 RSA 密钥对的公钥和私钥内容，至少 2048 位；不是 .pem 文件路径。
# 支持 PEM 或 base64 DER。公私钥缺失、无效或不匹配时，登录不可用或服务启动失败。
# .env 推荐填写单行 base64 DER：移除 PEM 的 BEGIN/END 行，将中间正文拼成一行。
# 私钥只用于后端签发 JWT，严禁提供给前端或提交到 Git。
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_PRIVATE_KEY=

# 必填：JWT 签发方和接收方。前后端环境应保持稳定，不要随意修改已有环境的值。
AUTH_JWT_ISSUER=olixops-permission-center
AUTH_JWT_AUDIENCE=olixops-permission-center-web

# 可选：管理员 JWT 有效期，范围 1s～24h，默认 8h。
AUTH_JWT_TOKEN_TTL=8h

# -----------------------------------------------------------------------------
# SpiceDB（第二阶段可选，默认禁用）
# -----------------------------------------------------------------------------

# false：不连接 SpiceDB；true：启动时连接并执行健康检查，配置错误或不可达会阻止启动。
# 健康检查只确认服务可达且处于 Serving，不代表业务 Schema 或权限关系已经正确。
SPICEDB_ENABLED=false

# 启用后必填：gRPC 地址，只写 host:port，不带 http:// 或 https://。
SPICEDB_ENDPOINT=

# 启用后必填：SpiceDB pre-shared key，仅供后端使用。
SPICEDB_TOKEN=

# 本地明文连接才设为 true；生产环境必须使用 TLS。
SPICEDB_INSECURE=false

# TLS 可选：自签或私有 CA 的 PEM 文件路径。insecure=true 时必须留空。
SPICEDB_CA_FILE=

# TLS 可选：证书中的服务端名称；insecure=true 时必须留空。
SPICEDB_SERVER_NAME=

# 可选：启动健康检查和单次调用超时，必须是大于 0 的 Go duration。
SPICEDB_TIMEOUT=5s
